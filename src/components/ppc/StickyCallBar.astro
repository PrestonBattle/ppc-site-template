---
/**
 * Mobile-only sticky CTA bar fixed to the bottom of the viewport.
 * Enabled via `cta.stickyBar` in client.yml. Hidden at desktop widths.
 */
interface Props {
  phone: string;
  phoneLink: string;
  bookingLink: string;
  callText?: string;
  bookText?: string;
}

const { phoneLink, bookingLink, callText = "Call Now", bookText = "Book Online" } = Astro.props;

const bookingIsExternal = /^https?:\/\//.test(bookingLink);
---

<div class="ppc-sticky-bar" role="region" aria-label="Contact options">
  <a href={phoneLink} class="ppc-sticky-btn ppc-sticky-call">
    <svg
      class="ppc-sticky-icon"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      width="18"
      height="18"
    >
      <path
        d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z"
      ></path>
    </svg>
    {callText}
  </a>
  <a
    href={bookingLink}
    class="ppc-sticky-btn ppc-sticky-book"
    data-track-booking
    target={bookingIsExternal ? "_blank" : undefined}
    rel={bookingIsExternal ? "noopener" : undefined}
  >
    <svg
      class="ppc-sticky-icon"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      width="18"
      height="18"
    >
      <path
        d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V10h14zM5 8V6h14v2z"
      ></path>
    </svg>
    {bookText}
  </a>
</div>

<style is:global>
  @layer page-sections {
    .ppc-sticky-bar {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 100;
      display: flex;
      box-shadow: 0 -2px 12px rgb(0 0 0 / 20%);
    }

    .ppc-sticky-btn {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1rem;
      padding-bottom: calc(0.9rem + env(safe-area-inset-bottom, 0px));
      font-size: 1rem;
      font-weight: 700;
      text-decoration: none;
    }

    .ppc-sticky-call {
      background: var(--ppc-brand);
      color: var(--ppc-brand-text);
    }

    .ppc-sticky-book {
      background: var(--ppc-btn-bg);
      color: var(--ppc-btn-text);
    }

    .ppc-sticky-icon {
      flex-shrink: 0;
    }

    /* When the sticky bar is present, keep it from covering the footer */
    .ppc-site:has(.ppc-sticky-bar) {
      padding-bottom: 3.5rem;
    }

    @media (width >= 768px) {
      .ppc-sticky-bar {
        display: none;
      }

      .ppc-site:has(.ppc-sticky-bar) {
        padding-bottom: 0;
      }
    }
  }
</style>
