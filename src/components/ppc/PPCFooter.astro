---
interface Props {
  practiceName: string;
  phone: string;
  phoneLink: string;
  address: string;
  mapLink: string;
  mapEmbedUrl?: string;
  hours: { day: string; hours: string }[];
  bookingLink: string;
  logoSrc: string;
  logoAlt: string;
  footerLogoSrc?: string;
  footerLogoAlt?: string;
  disclaimer: string;
  footer?: {
    layout?: "logo-info-map" | "logo-map-info" | "info-logo-map" | "stacked";
    showMap?: boolean;
    bgColor?: string;
    accentColor?: string;
    phoneColor?: string;
  };
}

const {
  practiceName,
  phone,
  phoneLink,
  address,
  mapLink,
  mapEmbedUrl,
  hours,
  bookingLink,
  logoSrc,
  logoAlt,
  footerLogoSrc,
  footerLogoAlt,
  disclaimer,
  footer = {},
} = Astro.props;

const {
  layout = "logo-info-map",
  showMap = true,
  bgColor,
  accentColor,
  phoneColor,
} = footer;

const activeLogo = footerLogoSrc || logoSrc;
const activeLogoAlt = footerLogoAlt || logoAlt;

const styleParts: string[] = [];
if (bgColor) styleParts.push(`--footer-bg: ${bgColor};`);
if (accentColor) styleParts.push(`--footer-accent: ${accentColor};`);
if (phoneColor) styleParts.push(`--footer-phone: ${phoneColor};`);
const footerStyle = styleParts.join(" ");

const layouts: Record<string, string[]> = {
  "logo-info-map": ["brand", "info", "map"],
  "logo-map-info": ["brand", "map", "info"],
  "info-logo-map": ["info", "brand", "map"],
  stacked: ["brand", "info", "map"],
};
const order = (layouts[layout] || layouts["logo-info-map"]).filter(
  (c) => showMap || c !== "map"
);
---

<footer class="ppc-footer" style={footerStyle}>
  <div class="ppc-footer-main">
    <div class:list={`ppc-footer-inner layout-${layout}${!showMap ? " no-map" : ""}`}>
      {order.map((col) => {
        if (col === "brand") return (
          <div class="ppc-footer-col ppc-footer-brand">
            <a href="/">
              {activeLogo
                ? <img src={activeLogo} alt={activeLogoAlt} class="ppc-footer-logo" />
                : <span class="ppc-footer-logo-text">{practiceName}</span>}
            </a>
            <a href={bookingLink} class="ppc-footer-schedule-btn" target="_blank" rel="noopener">
              Schedule Online
            </a>
          </div>
        );

        if (col === "info") return (
          <div class="ppc-footer-col ppc-footer-info">
            <div class="ppc-footer-block">
              <h3 class="ppc-footer-heading">Contact Us</h3>
              <a href={mapLink} class="ppc-footer-address" target="_blank" rel="noopener">{address}</a>
              <a href={phoneLink} class="ppc-footer-phone">{phone}</a>
            </div>
            <div class="ppc-footer-block">
              <h3 class="ppc-footer-heading">Office Hours</h3>
              <div class="ppc-hours-list">
                {hours.map(({ day, hours: h }) => (
                  <div class="ppc-hours-row">
                    <span>{day}</span>
                    <span>{h}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        );

        if (col === "map") return (
          <div class="ppc-footer-col ppc-footer-map">
            {mapEmbedUrl ? (
              <iframe src={mapEmbedUrl} width="100%" height="250" style="border:0;border-radius:8px" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`${practiceName} location map`} />
            ) : (
              <a href={mapLink} class="ppc-footer-map-link" target="_blank" rel="noopener">
                View on Google Maps →
              </a>
            )}
          </div>
        );
      })}
    </div>
  </div>

  <div class="ppc-footer-copyright">
    <p>
      © {new Date().getFullYear()} {practiceName} |
      <a href="/sitemap.html">Sitemap</a> |
      <a href="/privacy-policy.html">Privacy Policy</a> |
      Site designed and maintained by <a href="https://www.tntdental.com" target="_blank" rel="noopener">TNT Dental</a>
    </p>
  </div>

  {disclaimer && (
    <div class="ppc-footer-disclaimer">
      <p>{disclaimer}</p>
    </div>
  )}
</footer>

<style lang="pcss" is:global>
  @layer page-sections {
    .ppc-footer {
      /* Compute-once tokens for the whole footer */
      --_bg: var(--footer-bg, var(--color-brand));
      --_accent: var(--footer-accent, var(--color-accent, var(--ppc-accent)));
      --_phone: var(--footer-phone, var(--color-accent, var(--ppc-accent)));
      --_text: var(--color-text-on-brand, white);
      --_text-soft: color-mix(in srgb, var(--_text) 70%, transparent);
      --_text-muted: color-mix(in srgb, var(--_text) 50%, transparent);

      background: var(--_bg);
      color: var(--_text);
    }

    .ppc-footer-main {
      padding: var(--spacing-2xl) var(--spacing-lg);
    }

    .ppc-footer-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 200px 1fr 300px;
      gap: var(--spacing-2xl);
      align-items: start;
    }
    .ppc-footer-inner.no-map { grid-template-columns: 200px 1fr; }
    .ppc-footer-inner.layout-stacked {
      grid-template-columns: 1fr;
      max-width: 600px;
      text-align: center;
    }
    .ppc-footer-inner.layout-stacked .ppc-footer-brand { align-items: center; }

    .ppc-footer-brand {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-lg);
    }
    .ppc-footer-logo { max-width: 200px; height: auto; }
    .ppc-footer-logo-text { font-size: 1.1rem; font-weight: 700; }

    .ppc-footer-schedule-btn {
      display: inline-block;
      background: var(--_accent);
      color: var(--color-text-on-accent, var(--_text));
      padding: var(--spacing-sm) var(--spacing-xl);
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.85rem;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      transition: opacity 0.15s;
      white-space: nowrap;
    }
    .ppc-footer-schedule-btn:hover { opacity: 0.85; }

    .ppc-footer-info { display: flex; flex-direction: column; gap: var(--spacing-xl); }
    .ppc-footer-block { display: flex; flex-direction: column; }

    .ppc-footer-heading {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin: 0 0 var(--spacing-sm);
      padding-bottom: var(--spacing-xs);
      border-bottom: 2px solid var(--_accent);
    }

    .ppc-footer-address {
      color: var(--_text-soft);
      text-decoration: none;
      font-size: 0.9rem;
      line-height: 1.6;
      margin-bottom: var(--spacing-sm);
    }
    .ppc-footer-address:hover { color: var(--_text); }

    .ppc-footer-phone {
      color: var(--_phone);
      font-size: 1.4rem;
      font-weight: 800;
      text-decoration: none;
    }
    .ppc-footer-phone:hover { opacity: 0.85; }

    .ppc-hours-list { display: flex; flex-direction: column; gap: 6px; }
    .ppc-hours-row {
      display: flex;
      gap: 0;
      font-size: 0.95rem;
      color: var(--_text-soft);
    }
    .ppc-hours-row span:first-child { min-width: 130px; white-space: nowrap; }
    .ppc-hours-row span:last-child { color: var(--_text); }

    .ppc-footer-map-link {
      color: var(--_accent);
      font-size: 0.9rem;
      text-decoration: none;
    }
    .ppc-footer-map-link:hover { text-decoration: underline; }

    .ppc-footer-copyright,
    .ppc-footer-disclaimer {
      padding: var(--spacing-md) var(--spacing-lg);
      text-align: center;
    }
    .ppc-footer-copyright {
      background: rgba(0,0,0,0.25);
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .ppc-footer-copyright p {
      max-width: 1200px;
      margin: 0 auto;
      font-size: 0.82rem;
      color: var(--_text-muted);
    }
    .ppc-footer-copyright a { color: var(--_text-soft); text-decoration: none; }
    .ppc-footer-copyright a:hover { color: var(--_text); }

    .ppc-footer-disclaimer { background: rgba(0,0,0,0.15); }
    .ppc-footer-disclaimer p {
      max-width: 900px;
      margin: 0 auto;
      font-size: 0.75rem;
      color: var(--_text-muted);
      line-height: 1.7;
    }

    @media (max-width: 900px) {
      .ppc-footer-inner { grid-template-columns: 1fr 1fr; }
      .ppc-footer-map { grid-column: 1 / -1; }
    }
    @media (max-width: 600px) {
      .ppc-footer-inner { grid-template-columns: 1fr; }
    }
  }
</style>