---
import Analytics from "@components/ppc/Analytics.astro";
import PPCFooter from "@components/ppc/PPCFooter.astro";
import PPCHeader from "@components/ppc/PPCHeader.astro";
import StickyCallBar from "@components/ppc/StickyCallBar.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getEntry } from "astro:content";


interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const clientEntry = await getEntry("client", "client");

if (!clientEntry) {
  throw new Error("Missing client config: expected src/content/client/client.yml");
}
const client = clientEntry.data;
const { theme, header, footer, cta, tracking } = client;

const varMap: Record<string, string | undefined> = {
  "--ppc-brand":            theme.brand,
  "--ppc-brand-text":       theme.brandText,
  "--ppc-accent":           theme.accent,
  "--ppc-accent-text":      theme.accentText,
  "--ppc-brand-muted":      theme.brandMuted,
  "--ppc-brand-subtle":     theme.brandSubtle,
  "--ppc-dark":             theme.dark,
  "--ppc-link":             theme.link,
  "--ppc-link-hover":       theme.linkHover,
  "--ppc-bg":               theme.bg,
  "--ppc-bg-surface":       theme.bgSurface,
  "--ppc-bg-muted":         theme.bgMuted,
  "--ppc-bg-accent":        theme.bgAccent,
  "--ppc-bg-highlight":     theme.bgHighlight,
  "--ppc-text":             theme.text,
  "--ppc-text-strong":      theme.textStrong,
  "--ppc-text-muted":       theme.textMuted,
  "--ppc-text-inverse":     theme.textInverse,
  "--ppc-border":           theme.border,
  "--ppc-border-inputs":    theme.borderInputs,
  "--ppc-border-strong":    theme.borderStrong,
  "--ppc-border-subtle":    theme.borderSubtle,
  "--ppc-ann-bg":           theme.announcementBg,
  "--ppc-ann-text":         theme.announcementText,
  "--ppc-hero-bg":          theme.heroBg,
  "--ppc-hero-text":        theme.heroText,
  "--ppc-btn-bg":           theme.bookBtnBg ?? theme.accent,
  "--ppc-btn-text":         theme.bookBtnText ?? theme.accentText,
  "--ppc-phone-color":      theme.phoneColor ?? theme.accent,
};

const cssVars = Object.entries(varMap)
  .filter(([, val]) => Boolean(val))
  .map(([key, val]) => `${key}: ${val};`)
  .join(" ");
---


<BaseLayout title={title} description={description}>
  <Analytics slot="head" {...tracking} />

  <div class="ppc-site" style={cssVars}>
    <PPCHeader
      practiceName={client.practiceName}
      phone={client.phone}
      phoneLink={client.phoneLink}
      bookingLink={client.bookingLink}
      address={client.address}
      logoSrc={client.logo.src}
      logoAlt={client.logo.alt}
      announcementBar={header.announcementBar}
      bookBtnText={header.bookBtnText}
    />

    <slot />

    <PPCFooter
      practiceName={client.practiceName}
      phone={client.phone}
      phoneLink={client.phoneLink}
      address={client.address}
      mapLink={client.mapLink}
      mapEmbedUrl={client.mapEmbedUrl}
      hours={client.hours}
      bookingLink={client.bookingLink}
      logoSrc={client.logo.src}
      logoAlt={client.logo.alt}
      footerLogoSrc={client.footerLogo?.src}
      footerLogoAlt={client.footerLogo?.alt}
      disclaimer={footer.disclaimer}
      footer={footer}
    />

    {
      cta.stickyBar.enabled && (
        <StickyCallBar
          phone={client.phone}
          phoneLink={client.phoneLink}
          bookingLink={client.bookingLink}
          callText={cta.stickyBar.callText}
          bookText={cta.stickyBar.bookText}
        />
      )
    }
  </div>
</BaseLayout>

<script>
  if (window.inEditorMode) {
    import("../../live-editing");
  }
</script>
