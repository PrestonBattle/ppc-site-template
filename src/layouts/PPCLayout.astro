---
import Analytics from "@components/ppc/Analytics.astro";
import PPCFooter from "@components/ppc/PPCFooter.astro";
import PPCHeader from "@components/ppc/PPCHeader.astro";
import StickyCallBar from "@components/ppc/StickyCallBar.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getEntry } from "astro:content";


interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const clientEntry = await getEntry("client", "client");

if (!clientEntry) {
  throw new Error("Missing client config: expected src/content/client/client.yml");
}
const client = clientEntry.data;
const { theme, header, footer, cta, tracking } = client;

// ---- Preset resolution -----------------------------------------------------
// If a preset is selected (and not "custom"), load its values as the base.
// Any explicit theme.* field in client.yml overrides the preset value.
let presetValues: Record<string, string> = {};

if (theme.preset && theme.preset !== "custom") {
  const presetEntry = await getEntry("themePresets", theme.preset);
  if (presetEntry) {
    const { name, description: _desc, ...colors } = presetEntry.data;
    presetValues = colors as Record<string, string>;
  } else {
    console.warn(`[PPCLayout] Preset '${theme.preset}' not found — using explicit theme values only`);
  }
}

// Merge preset defaults with explicit theme values. Explicit values always win.
const t = (field: string): string | undefined =>
  ((theme as Record<string, unknown>)[field] as string | undefined) ?? presetValues[field];

const varMap: Record<string, string | undefined> = {
  "--ppc-brand":            t("brand"),
  "--ppc-brand-text":       t("brandText"),
  "--ppc-accent":           t("accent"),
  "--ppc-accent-text":      t("accentText"),
  "--ppc-brand-muted":      t("brandMuted"),
  "--ppc-brand-subtle":     t("brandSubtle"),
  "--ppc-dark":             t("dark"),
  "--ppc-link":             t("link"),
  "--ppc-link-hover":       t("linkHover"),
  "--ppc-bg":               t("bg"),
  "--ppc-bg-surface":       t("bgSurface"),
  "--ppc-bg-muted":         t("bgMuted"),
  "--ppc-bg-accent":        t("bgAccent"),
  "--ppc-bg-highlight":     t("bgHighlight"),
  "--ppc-text":             t("text"),
  "--ppc-text-strong":      t("textStrong"),
  "--ppc-text-muted":       t("textMuted"),
  "--ppc-text-inverse":     t("textInverse"),
  "--ppc-border":           t("border"),
  "--ppc-border-inputs":    t("borderInputs"),
  "--ppc-border-strong":    t("borderStrong"),
  "--ppc-border-subtle":    t("borderSubtle"),
  "--ppc-ann-bg":           t("announcementBg"),
  "--ppc-ann-text":         t("announcementText"),
  "--ppc-hero-bg":          t("heroBg"),
  "--ppc-hero-text":        t("heroText"),
  "--ppc-btn-bg":           t("bookBtnBg") ?? t("accent"),
  "--ppc-btn-text":         t("bookBtnText") ?? t("accentText"),
  "--ppc-phone-color":      t("phoneColor") ?? t("accent"),
};

const cssVars = Object.entries(varMap)
  .filter(([, val]) => Boolean(val))
  .map(([key, val]) => `${key}: ${val};`)
  .join(" ");
---


<BaseLayout title={title} description={description}>
  <Analytics slot="head" {...tracking} />

  <div class="ppc-site" style={cssVars}>
    <PPCHeader
      practiceName={client.practiceName}
      phone={client.phone}
      phoneLink={client.phoneLink}
      bookingLink={client.bookingLink}
      address={client.address}
      logoSrc={client.logo.src}
      logoAlt={client.logo.alt}
      announcementBar={header.announcementBar}
      bookBtnText={header.bookBtnText}
    />

    <slot />

    <PPCFooter
      practiceName={client.practiceName}
      phone={client.phone}
      phoneLink={client.phoneLink}
      address={client.address}
      mapLink={client.mapLink}
      mapEmbedUrl={client.mapEmbedUrl}
      hours={client.hours}
      bookingLink={client.bookingLink}
      logoSrc={client.logo.src}
      logoAlt={client.logo.alt}
      footerLogoSrc={client.footerLogo?.src}
      footerLogoAlt={client.footerLogo?.alt}
      disclaimer={footer.disclaimer}
      footer={footer}
    />

    {
      cta.stickyBar.enabled && (
        <StickyCallBar
          phone={client.phone}
          phoneLink={client.phoneLink}
          bookingLink={client.bookingLink}
          callText={cta.stickyBar.callText}
          bookText={cta.stickyBar.bookText}
        />
      )
    }
  </div>
</BaseLayout>

<script>
  if (window.inEditorMode) {
    import("../../live-editing");
  }
</script>