[data-theme="default"] {
  color-scheme: light;

  --color-brand:          #1a3a5c;
  --color-brand-muted:    #2a5282;
  --color-brand-subtle:   #4a7ab5;
  --color-brand-on:       #ffffff;

  --color-text:           var(--gray-10);
  --color-text-strong:    var(--gray-12);
  --color-text-muted:     var(--gray-8);
  --color-text-on-muted:  var(--gray-12);
  --color-text-on-brand:  #ffffff;
  --color-text-inverse:   var(--gray-0);

  --color-link:           #1a3a5c;
  --color-link-hover:     #2a5282;

  --color-bg:             #ffffff;
  --color-bg-surface:     #f4f7fb;
  --color-bg-muted:       #e8eef5;
  --color-bg-accent:      #fff8e1;
  --color-bg-highlight:   #fff3cd;
  --color-bg-brand:       var(--color-brand);
  --color-bg-brand-muted: var(--color-brand-muted);
  --color-bg-inverse:     #1a3a5c;

  --color-border:         var(--gray-4);
  --color-border-inputs:  var(--gray-7);
  --color-border-strong:  var(--gray-10);
  --color-border-subtle:  #e8eef5;

  --color-state-hover:    rgba(26, 58, 92, 0.06);
  --color-state-active:   rgba(26, 58, 92, 0.12);
  --color-overlay:        rgba(0, 0, 0, 0.5);
  --color-focus-ring:     rgba(26, 58, 92, 0.4);
  --color-error:          #f00;
}