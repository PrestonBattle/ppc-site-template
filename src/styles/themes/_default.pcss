[data-theme="default"] {
  color-scheme: light;

  /* ============ BRAND ============ */
  --color-brand:          var(--ppc-brand, #1a3a5c);
  --color-brand-muted:    var(--ppc-brand-muted, #2a5282);
  --color-brand-subtle:   var(--ppc-brand-subtle, #4a7ab5);
  --color-brand-on:       var(--ppc-brand-text, #ffffff);
  --color-text-on-brand:  var(--ppc-brand-text, #ffffff);
  --color-accent:         var(--ppc-accent, #78b843);
  --color-text-on-accent: var(--ppc-accent-text, #ffffff);
  /* ============ LINKS ============ */
  --color-link:           var(--ppc-link, var(--ppc-accent, #1a3a5c));
  --color-link-hover:     var(--ppc-link-hover, var(--ppc-brand, #2a5282));

  /* ============ BACKGROUNDS ============ */
  --color-bg:             var(--ppc-bg, #ffffff);
  --color-bg-surface:     var(--ppc-bg-surface, #f4f7fb);
  --color-bg-muted:       var(--ppc-bg-muted, #e8eef5);
  --color-bg-accent:      var(--ppc-bg-accent, #fff8e1);
  --color-bg-highlight:   var(--ppc-bg-highlight, #fff3cd);
  --color-bg-brand:       var(--ppc-brand, #1a3a5c);
  --color-bg-brand-muted: var(--ppc-brand-muted, #2a5282);
  --color-bg-inverse:     var(--ppc-dark, #1a3a5c);

  /* ============ TEXT ============ */
  --color-text:           var(--ppc-text, var(--gray-10));
  --color-text-strong:    var(--ppc-text-strong, var(--gray-12));
  --color-text-muted:     var(--ppc-text-muted, var(--gray-8));
  --color-text-on-muted:  var(--ppc-text-on-muted, var(--gray-12));
  --color-text-inverse:   var(--ppc-text-inverse, var(--gray-0));

  /* ============ BORDERS ============ */
  --color-border:         var(--ppc-border, var(--gray-4));
  --color-border-inputs:  var(--ppc-border-inputs, var(--gray-7));
  --color-border-strong:  var(--ppc-border-strong, var(--gray-10));
  --color-border-subtle:  var(--ppc-border-subtle, #e8eef5);

  /* ============ INTERACTION STATES ============ */
  --color-state-hover:    var(--ppc-state-hover, rgba(26, 58, 92, 0.06));
  --color-state-active:   var(--ppc-state-active, rgba(26, 58, 92, 0.12));
  --color-overlay:        var(--ppc-overlay, rgba(0, 0, 0, 0.5));
  --color-focus-ring:     var(--ppc-focus-ring, rgba(26, 58, 92, 0.4));
  --color-error:          var(--ppc-error, #f00);
}